    <!-- http://www.semanticweb.org/banking-fraud-kg#Account -->

    <owl:Class rdf:about="http://www.semanticweb.org/banking-fraud-kg#Account">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Entity"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Bank"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Currency"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#FraudIndicator"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#LaunderingPattern"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#PaymentFormat"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Transaction"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/banking-fraud-kg#Bank -->

    <owl:Class rdf:about="http://www.semanticweb.org/banking-fraud-kg#Bank">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Entity"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Currency"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#FraudIndicator"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#LaunderingPattern"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#PaymentFormat"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Transaction"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/banking-fraud-kg#Currency -->

    <owl:Class rdf:about="http://www.semanticweb.org/banking-fraud-kg#Currency">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#FraudIndicator"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#LaunderingPattern"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#PaymentFormat"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Transaction"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/banking-fraud-kg#Entity -->

    <owl:Class rdf:about="http://www.semanticweb.org/banking-fraud-kg#Entity"/>
    


    <!-- http://www.semanticweb.org/banking-fraud-kg#FraudIndicator -->

    <owl:Class rdf:about="http://www.semanticweb.org/banking-fraud-kg#FraudIndicator">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#LaunderingPattern"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#PaymentFormat"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Transaction"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/banking-fraud-kg#FraudulentTransaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/banking-fraud-kg#FraudulentTransaction">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/banking-fraud-kg#Transaction"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/banking-fraud-kg#belongsToPattern"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/banking-fraud-kg#LaunderingPattern"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Transaction"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/banking-fraud-kg#LaunderingPattern -->

    <owl:Class rdf:about="http://www.semanticweb.org/banking-fraud-kg#LaunderingPattern">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#PaymentFormat"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Transaction"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/banking-fraud-kg#PaymentFormat -->

    <owl:Class rdf:about="http://www.semanticweb.org/banking-fraud-kg#PaymentFormat">
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Transaction"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/banking-fraud-kg#Transaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/banking-fraud-kg#Transaction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/banking-fraud-kg#Entity"/>
    </owl:Class>
    


